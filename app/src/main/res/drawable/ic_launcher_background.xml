<?xml version="1.0" encoding="utf-8"?>
<!--
  图标底：深青夜空，光源偏低偏中。

  为什么不是纯色：极光要「亮起来」，底就得是一块有明暗的夜空。纯平色会让那道弧
  看起来像贴上去的色块；中间偏下那一圈更亮，弧才有发光的感觉。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
  <path android:pathData="M0,0h108v108h-108z">
    <aapt:attr name="android:fillColor">
      <gradient
          android:type="radial"
          android:centerX="50"
          android:centerY="69"
          android:gradientRadius="93"
          android:startColor="#FF155A45"
          android:centerColor="#FF0A2C24"
          android:endColor="#FF04120F" />
    </aapt:attr>
  </path>
</vector>
