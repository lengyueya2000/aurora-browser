<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      投屏与「把视频交给播放器打开」都要先问系统「有没有应用能接」。Android 11+ 的包
      可见性规则下，不声明 <queries> 就查不到目标包，resolveActivity 会恒为 null——
      投屏入口会永远报「本机没有可用的投屏功能」，扫码/语音也会恒判为「未安装」。
    -->
    <queries>
        <intent>
            <action android:name="android.settings.CAST_SETTINGS" />
        </intent>
        <intent>
            <action android:name="com.android.settings.WIFI_DISPLAY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
        <intent>
            <action android:name="com.google.zxing.client.android.SCAN" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".AuroraApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Aurora">
        <!--
          configChanges 要把「可能变的全列上」：网页视频进全屏时，系统栏隐藏本身就可能
          改变 screenLayout / smallestScreenSize，漏掉哪一项都会让 Activity 被销毁重建——
          刚挂上去的全屏 View 连同页面一起没了，表现就是「点全屏没反应」。
          全屏还会把界面掰成横屏（见 ActivityFullscreenHost），orientation 同样在其中；
          colorMode / grammaticalGender / fontWeightAdjustment 是 Android 12+ 单独广播的
          几项（深色模式、语言性别、系统字重），一并声明，省得又被重建一次。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale|touchscreen|colorMode|grammaticalGender|fontWeightAdjustment">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
